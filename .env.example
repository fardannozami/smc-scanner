# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# MetaTrader 5
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server

# Scanner settings
SCAN_INTERVAL=60
ALERT_COOLDOWN_MINUTES=60

# Risk management
MAX_RISK_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN=3.0
MAX_WEEKLY_DRAWDOWN=6.0
MAX_CONSECUTIVE_LOSSES=3

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=15

# Paper trading (virtual positions + strategy win rate)
PAPER_TRADING_ENABLED=true
PAPER_LOT=0.01
PAPER_TP_LEVEL=tp1
PAPER_MAX_HOLD_HOURS=168
PAPER_ALLOW_STACKING=false

# Database
DB_PATH=trading_scanner.db
